<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Naslov razdelka obrazca -->
    <style name="NaslovRazdelka">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/besedilo</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Kratko pojasnilo pod naslovom razdelka -->
    <style name="PodnaslovRazdelka">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/besedilo_sivo</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Oznaka nad vnosnim poljem (z velikimi črkami) -->
    <style name="Oznaka">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/besedilo_sivo</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Vnosno polje z belim ozadjem in obrobo -->
    <style name="Polje">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_polje</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/besedilo</item>
        <item name="android:textColorHint">@color/besedilo_sivo</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Vrstica za izbiro datuma ali ure -->
    <style name="VrsticaIzbire">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_polje</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Izbirni gumb za način kontakta -->
    <style name="IzbirniGumb">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/besedilo</item>
        <item name="android:textSize">15sp</item>
        <item name="buttonTint">@color/navy</item>
    </style>
</resources>
